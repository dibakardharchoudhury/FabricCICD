{
  "name": "PL_Copy_Bronze_Ingest",
  "objectId": "00000000-0000-0000-0000-000000000002",
  "properties": {
    "description": "Copy Activity pipeline — ingests raw files from SharePoint/OneLake Files into Bronze Lakehouse Delta tables. Demonstrates Fabric Copy Activity in CI/CD context.",
    "activities": [
      {
        "name": "Copy_Production_CSV",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 2,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "source": {
            "type": "BinarySource",
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": false,
              "modifiedDatetimeStart": "#{pipeline().parameters.LastRefreshDate}"
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "sink": {
            "type": "LakehouseTableSink",
            "tableActionOption": "Append",
            "partitionOption": "None"
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "mappings": [
              { "source": { "name": "well_id" },   "sink": { "name": "well_id",   "type": "String" } },
              { "source": { "name": "date" },       "sink": { "name": "date",      "type": "Date"   } },
              { "source": { "name": "field" },      "sink": { "name": "field",     "type": "String" } },
              { "source": { "name": "oil_bbl" },    "sink": { "name": "oil_bbl",   "type": "Double" } },
              { "source": { "name": "gas_mcf" },    "sink": { "name": "gas_mcf",   "type": "Double" } },
              { "source": { "name": "water_bbl" },  "sink": { "name": "water_bbl", "type": "Double" } },
              { "source": { "name": "status" },     "sink": { "name": "status",    "type": "String" } }
            ]
          }
        },
        "inputs": [
          {
            "referenceName": "DS_OneLake_Files_CSV",
            "type": "DatasetReference",
            "parameters": {
              "fileName": "production_data.csv",
              "folderPath": "Files/ingestion/#{pipeline().parameters.Environment}"
            }
          }
        ],
        "outputs": [
          {
            "referenceName": "DS_Bronze_LH_Table",
            "type": "DatasetReference",
            "parameters": {
              "tableName": "production_raw"
            }
          }
        ]
      },
      {
        "name": "Copy_Cost_CSV",
        "type": "Copy",
        "dependsOn": [
          { "activity": "Copy_Production_CSV", "dependencyConditions": ["Succeeded"] }
        ],
        "typeProperties": {
          "source": { "type": "BinarySource" },
          "sink": { "type": "LakehouseTableSink", "tableActionOption": "Append" }
        },
        "inputs":  [{ "referenceName": "DS_OneLake_Files_CSV", "parameters": { "fileName": "cost_data.csv", "folderPath": "Files/ingestion/#{pipeline().parameters.Environment}" } }],
        "outputs": [{ "referenceName": "DS_Bronze_LH_Table",   "parameters": { "tableName": "cost_raw" } }]
      },
      {
        "name": "Copy_Schedule_CSV",
        "type": "Copy",
        "dependsOn": [
          { "activity": "Copy_Production_CSV", "dependencyConditions": ["Succeeded"] }
        ],
        "typeProperties": {
          "source": { "type": "BinarySource" },
          "sink": { "type": "LakehouseTableSink", "tableActionOption": "Append" }
        },
        "inputs":  [{ "referenceName": "DS_OneLake_Files_CSV", "parameters": { "fileName": "schedule_data.csv", "folderPath": "Files/ingestion/#{pipeline().parameters.Environment}" } }],
        "outputs": [{ "referenceName": "DS_Bronze_LH_Table",   "parameters": { "tableName": "schedule_raw" } }]
      }
    ],
    "parameters": {
      "Environment": {
        "type": "string",
        "defaultValue": "dev"
      },
      "LastRefreshDate": {
        "type": "string",
        "defaultValue": "2024-01-01T00:00:00Z",
        "description": "Incremental load watermark — files modified after this date are picked up"
      }
    },
    "datasets": {
      "DS_OneLake_Files_CSV": {
        "type": "DelimitedText",
        "linkedService": "Bronze_LH_Files",
        "typeProperties": {
          "location": {
            "type": "LakehouseLocation",
            "fileName": "@dataset().fileName",
            "folderPath": "@dataset().folderPath"
          },
          "columnDelimiter": ",",
          "rowDelimiter": "\n",
          "firstRowAsHeader": true,
          "quoteChar": "\""
        },
        "parameters": {
          "fileName":   { "type": "string" },
          "folderPath": { "type": "string" }
        }
      },
      "DS_Bronze_LH_Table": {
        "type": "LakehouseTable",
        "linkedService": "Bronze_LH",
        "typeProperties": {
          "table": "@dataset().tableName"
        },
        "parameters": {
          "tableName": { "type": "string" }
        }
      }
    }
  }
}
