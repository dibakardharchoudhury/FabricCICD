{
  "name": "PL_Refresh_Master",
  "objectId": "00000000-0000-0000-0000-000000000001",
  "properties": {
    "description": "Master orchestration pipeline — runs Bronze → Silver → Gold in sequence. Used in both stages (Dev/Prod). Environment parameter controls stage-specific behavior.",
    "activities": [
      {
        "name": "NB_Seed_Bronze",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "notebookId": "NB_01_Seed_Bronze",
          "workspaceId": "#{pipeline().parameters.WorkspaceId}",
          "parameters": {
            "environment": {
              "value": "#{pipeline().parameters.Environment}",
              "type": "string"
            }
          }
        }
      },
      {
        "name": "NB_Transform_Silver",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "NB_Seed_Bronze",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:30:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "notebookId": "NB_02_Transform_Silver",
          "workspaceId": "#{pipeline().parameters.WorkspaceId}",
          "parameters": {
            "environment": {
              "value": "#{pipeline().parameters.Environment}",
              "type": "string"
            }
          }
        }
      },
      {
        "name": "NB_Aggregate_Gold",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "NB_Transform_Silver",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "notebookId": "NB_03_Aggregate_Gold",
          "workspaceId": "#{pipeline().parameters.WorkspaceId}",
          "parameters": {
            "environment": {
              "value": "#{pipeline().parameters.Environment}",
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Refresh_Semantic_Model",
        "type": "RefreshDataset",
        "dependsOn": [
          {
            "activity": "NB_Aggregate_Gold",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 2,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "datasetId": "#{pipeline().parameters.SemanticModelId}",
          "workspaceId": "#{pipeline().parameters.WorkspaceId}",
          "retryPolicy": {
            "type": "exponentialBackoff",
            "retryAttempts": 2
          }
        }
      }
    ],
    "parameters": {
      "Environment": {
        "type": "string",
        "defaultValue": "dev",
        "description": "Target environment: dev | prod. Set by Deployment Rules per stage."
      },
      "WorkspaceId": {
        "type": "string",
        "defaultValue": "",
        "description": "Fabric workspace ID — auto-populated by the platform at runtime."
      },
      "SemanticModelId": {
        "type": "string",
        "defaultValue": "",
        "description": "Gold_SM semantic model ID — set via Deployment Rules per stage."
      }
    },
    "annotations": [
      "MedallionLayer=All",
      "CICDDemo=true",
      "Version=1.0"
    ]
  }
}
