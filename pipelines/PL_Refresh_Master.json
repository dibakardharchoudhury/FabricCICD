{
  "name": "PL_Refresh_Master",
  "objectId": "00000000-0000-0000-0000-000000000001",
  "properties": {
    "description": "Master orchestration - runs the full Medallion end to end: NB_01_Seed_Bronze -> NB_02_Transform_Silver -> DF_Gold_PA (builds Gold production_daily) -> NB_03_Aggregate_Gold (cost/schedule/KPI) -> Refresh Gold_SM. Fully parameterized: workspace resolves at runtime via @pipeline().DataFactory (no per-stage rebinding); every item GUID is a pipeline parameter set per stage by Deployment Rules.",
    "activities": [
      {
        "name": "NB_Seed_Bronze",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": { "timeout": "0.01:00:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "notebookId": { "value": "@pipeline().parameters.BronzeNotebookId", "type": "Expression" },
          "workspaceId": { "value": "@pipeline().DataFactory", "type": "Expression" },
          "parameters": {
            "environment": { "value": { "value": "@pipeline().parameters.Environment", "type": "Expression" }, "type": "string" }
          }
        }
      },
      {
        "name": "NB_Transform_Silver",
        "type": "TridentNotebook",
        "dependsOn": [ { "activity": "NB_Seed_Bronze", "dependencyConditions": ["Succeeded"] } ],
        "policy": { "timeout": "0.01:30:00", "retry": 1, "retryIntervalInSeconds": 60, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "notebookId": { "value": "@pipeline().parameters.SilverNotebookId", "type": "Expression" },
          "workspaceId": { "value": "@pipeline().DataFactory", "type": "Expression" },
          "parameters": {
            "environment": { "value": { "value": "@pipeline().parameters.Environment", "type": "Expression" }, "type": "string" }
          }
        }
      },
      {
        "name": "DF_Gold_Production",
        "type": "RefreshDataflow",
        "dependsOn": [ { "activity": "NB_Transform_Silver", "dependencyConditions": ["Succeeded"] } ],
        "policy": { "timeout": "0.01:00:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "dataflowId": { "value": "@pipeline().parameters.GoldDataflowId", "type": "Expression" },
          "workspaceId": { "value": "@pipeline().DataFactory", "type": "Expression" },
          "notifyOption": "NoNotification"
        }
      },
      {
        "name": "NB_Aggregate_Gold",
        "type": "TridentNotebook",
        "dependsOn": [ { "activity": "DF_Gold_Production", "dependencyConditions": ["Succeeded"] } ],
        "policy": { "timeout": "0.01:00:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "notebookId": { "value": "@pipeline().parameters.GoldNotebookId", "type": "Expression" },
          "workspaceId": { "value": "@pipeline().DataFactory", "type": "Expression" },
          "parameters": {
            "environment": { "value": { "value": "@pipeline().parameters.Environment", "type": "Expression" }, "type": "string" }
          }
        }
      },
      {
        "name": "Refresh_Semantic_Model",
        "type": "TridentDatasetRefresh",
        "dependsOn": [ { "activity": "NB_Aggregate_Gold", "dependencyConditions": ["Succeeded"] } ],
        "policy": { "timeout": "0.00:30:00", "retry": 2, "retryIntervalInSeconds": 60, "secureOutput": false, "secureInput": false },
        "typeProperties": {
          "datasetId": { "value": "@pipeline().parameters.SemanticModelId", "type": "Expression" }
        }
      }
    ],
    "parameters": {
      "Environment":      { "type": "string", "defaultValue": "dev" },
      "BronzeNotebookId": { "type": "string", "defaultValue": "00000000-0000-0000-0000-000000000000" },
      "SilverNotebookId": { "type": "string", "defaultValue": "00000000-0000-0000-0000-000000000000" },
      "GoldDataflowId":   { "type": "string", "defaultValue": "00000000-0000-0000-0000-000000000000" },
      "GoldNotebookId":   { "type": "string", "defaultValue": "00000000-0000-0000-0000-000000000000" },
      "SemanticModelId":  { "type": "string", "defaultValue": "00000000-0000-0000-0000-000000000000" }
    },
    "annotations": [ "MedallionLayer=All", "CICDDemo=true", "Version=2.0" ]
  }
}
