{
  "name": "Gold_SM",
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "production_daily",
        "description": "Daily production volumes aggregated by field — from Gold_LH",
        "columns": [
          { "name": "date",               "dataType": "dateTime",  "sourceColumn": "date"               },
          { "name": "field",              "dataType": "string",    "sourceColumn": "field"              },
          { "name": "total_oil_bbl",      "dataType": "double",    "sourceColumn": "total_oil_bbl"      },
          { "name": "total_gas_mcf",      "dataType": "double",    "sourceColumn": "total_gas_mcf"      },
          { "name": "total_water_bbl",    "dataType": "double",    "sourceColumn": "total_water_bbl"    },
          { "name": "total_boe",          "dataType": "double",    "sourceColumn": "total_boe"          },
          { "name": "avg_water_cut_pct",  "dataType": "double",    "sourceColumn": "avg_water_cut_pct"  },
          { "name": "active_well_count",  "dataType": "int64",     "sourceColumn": "active_well_count"  },
          { "name": "report_generated_at","dataType": "dateTime",  "sourceColumn": "report_generated_at","isHidden": true }
        ],
        "measures": [
          {
            "name": "Total BOE",
            "expression": "SUM(production_daily[total_boe])",
            "formatString": "#,##0.00",
            "description": "Total Barrels of Oil Equivalent"
          },
          {
            "name": "Total Oil (Bbl)",
            "expression": "SUM(production_daily[total_oil_bbl])",
            "formatString": "#,##0",
            "description": "Total oil production in barrels"
          },
          {
            "name": "Total Gas (Mcf)",
            "expression": "SUM(production_daily[total_gas_mcf])",
            "formatString": "#,##0",
            "description": "Total gas production in thousand cubic feet"
          },
          {
            "name": "Avg Water Cut %",
            "expression": "AVERAGE(production_daily[avg_water_cut_pct])",
            "formatString": "0.00%",
            "description": "Average water cut percentage across fields"
          },
          {
            "name": "Active Wells",
            "expression": "MAX(production_daily[active_well_count])",
            "formatString": "#,##0",
            "description": "Count of active producing wells"
          },
          {
            "name": "BOE Last Day",
            "expression": "CALCULATE(SUM(production_daily[total_boe]), LASTDATE(production_daily[date]))",
            "formatString": "#,##0.00",
            "description": "Total BOE on the most recent date in the dataset"
          }
        ],
        "partitions": [
          {
            "name": "production_daily-partition",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "production_daily",
              "schemaName": "dbo"
            }
          }
        ]
      },
      {
        "name": "cost_monthly",
        "description": "Monthly cost summary by field and cost type — from Gold_LH",
        "columns": [
          { "name": "year_month",          "dataType": "string",   "sourceColumn": "year_month"          },
          { "name": "field",               "dataType": "string",   "sourceColumn": "field"               },
          { "name": "cost_type",           "dataType": "string",   "sourceColumn": "cost_type"           },
          { "name": "total_cost_usd",      "dataType": "double",   "sourceColumn": "total_cost_usd"      },
          { "name": "avg_cost_per_boe",    "dataType": "double",   "sourceColumn": "avg_cost_per_boe"    },
          { "name": "transaction_count",   "dataType": "int64",    "sourceColumn": "transaction_count"   },
          { "name": "max_single_cost_usd", "dataType": "double",   "sourceColumn": "max_single_cost_usd","isHidden": true },
          { "name": "report_generated_at", "dataType": "dateTime", "sourceColumn": "report_generated_at","isHidden": true }
        ],
        "measures": [
          {
            "name": "Total Cost (USD)",
            "expression": "SUM(cost_monthly[total_cost_usd])",
            "formatString": "$ #,##0",
            "description": "Total operational and capital expenditure"
          },
          {
            "name": "Avg Cost per BOE",
            "expression": "AVERAGE(cost_monthly[avg_cost_per_boe])",
            "formatString": "$ #,##0.00",
            "description": "Average cost per Barrel of Oil Equivalent"
          },
          {
            "name": "OPEX Total",
            "expression": "CALCULATE(SUM(cost_monthly[total_cost_usd]), cost_monthly[cost_type] = \"OPEX\")",
            "formatString": "$ #,##0",
            "description": "Total operational expenditure"
          },
          {
            "name": "CAPEX Total",
            "expression": "CALCULATE(SUM(cost_monthly[total_cost_usd]), cost_monthly[cost_type] = \"CAPEX\")",
            "formatString": "$ #,##0",
            "description": "Total capital expenditure"
          },
          {
            "name": "OPEX/CAPEX Ratio",
            "expression": "DIVIDE([OPEX Total], [CAPEX Total] + 0.001, 0)",
            "formatString": "#,##0.00",
            "description": "Ratio of OPEX to CAPEX"
          }
        ],
        "partitions": [
          {
            "name": "cost_monthly-partition",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "cost_monthly",
              "schemaName": "dbo"
            }
          }
        ]
      },
      {
        "name": "schedule_summary",
        "description": "Activity schedule summary by field and priority — from Gold_LH",
        "columns": [
          { "name": "field",              "dataType": "string",   "sourceColumn": "field"              },
          { "name": "priority",           "dataType": "string",   "sourceColumn": "priority"           },
          { "name": "status",             "dataType": "string",   "sourceColumn": "status"             },
          { "name": "activity_count",     "dataType": "int64",    "sourceColumn": "activity_count"     },
          { "name": "avg_duration_days",  "dataType": "double",   "sourceColumn": "avg_duration_days"  },
          { "name": "critical_count",     "dataType": "int64",    "sourceColumn": "critical_count"     },
          { "name": "in_progress_count",  "dataType": "int64",    "sourceColumn": "in_progress_count"  },
          { "name": "report_generated_at","dataType": "dateTime", "sourceColumn": "report_generated_at","isHidden": true }
        ],
        "measures": [
          {
            "name": "Critical Activities",
            "expression": "SUM(schedule_summary[critical_count])",
            "formatString": "#,##0",
            "description": "Total critical priority activities"
          },
          {
            "name": "Activities In Progress",
            "expression": "SUM(schedule_summary[in_progress_count])",
            "formatString": "#,##0",
            "description": "Activities currently in progress"
          },
          {
            "name": "Total Activities",
            "expression": "SUM(schedule_summary[activity_count])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "schedule_summary-partition",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "schedule_summary",
              "schemaName": "dbo"
            }
          }
        ]
      },
      {
        "name": "field_kpi_facts",
        "description": "Cross-domain KPI fact table per field — from Gold_LH",
        "columns": [
          { "name": "field",              "dataType": "string",   "sourceColumn": "field"              },
          { "name": "avg_daily_boe",      "dataType": "double",   "sourceColumn": "avg_daily_boe"      },
          { "name": "cumulative_oil_bbl", "dataType": "double",   "sourceColumn": "cumulative_oil_bbl" },
          { "name": "avg_active_wells",   "dataType": "double",   "sourceColumn": "avg_active_wells"   },
          { "name": "total_cost_usd",     "dataType": "double",   "sourceColumn": "total_cost_usd"     },
          { "name": "avg_cost_per_boe",   "dataType": "double",   "sourceColumn": "avg_cost_per_boe"   }
        ],
        "measures": [
          {
            "name": "Field Count",
            "expression": "DISTINCTCOUNT(field_kpi_facts[field])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "field_kpi_facts-partition",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "field_kpi_facts",
              "schemaName": "dbo"
            }
          }
        ]
      },
      {
        "name": "DateDim",
        "description": "Standard date dimension for time intelligence",
        "columns": [
          { "name": "Date",         "dataType": "dateTime", "sourceColumn": "Date",         "isKey": true },
          { "name": "Year",         "dataType": "int64",    "sourceColumn": "Year"          },
          { "name": "Month",        "dataType": "int64",    "sourceColumn": "Month"         },
          { "name": "MonthName",    "dataType": "string",   "sourceColumn": "MonthName"     },
          { "name": "Quarter",      "dataType": "string",   "sourceColumn": "Quarter"       },
          { "name": "WeekNumber",   "dataType": "int64",    "sourceColumn": "WeekNumber"    }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "DateDim-calculated",
            "mode": "calculated",
            "source": {
              "type": "calculated",
              "expression": "CALENDAR(DATE(2024,1,1), DATE(2024,12,31))"
            }
          }
        ],
        "calculatedColumns": [
          { "name": "Year",       "expression": "YEAR([Date])",                       "dataType": "int64"    },
          { "name": "Month",      "expression": "MONTH([Date])",                      "dataType": "int64"    },
          { "name": "MonthName",  "expression": "FORMAT([Date], \"MMM YYYY\")",       "dataType": "string"   },
          { "name": "Quarter",    "expression": "\"Q\" & QUARTER([Date])",            "dataType": "string"   },
          { "name": "WeekNumber", "expression": "WEEKNUM([Date])",                    "dataType": "int64"    }
        ]
      }
    ],
    "relationships": [
      {
        "name": "production_daily_to_DateDim",
        "fromTable": "production_daily",
        "fromColumn": "date",
        "toTable": "DateDim",
        "toColumn": "Date",
        "crossFilteringBehavior": "singleDirection"
      },
      {
        "name": "field_kpi_to_production",
        "fromTable": "production_daily",
        "fromColumn": "field",
        "toTable": "field_kpi_facts",
        "toColumn": "field",
        "crossFilteringBehavior": "singleDirection",
        "isActive": false
      }
    ],
    "annotations": [
      { "name": "PBIDesktopVersion", "value": "2.130.0.0" },
      { "name": "TabularEditor_SerializeOptions_IgnoreInferredObjects", "value": "true" },
      { "name": "CICDDemo", "value": "Gold_SM_v1.0" }
    ]
  }
}
